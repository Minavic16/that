# NestQuant S7 — Environment Configuration
# ===========================================
# Copy this to .env and fill in values.
# NEVER commit .env to Git.

# MT5 Bridge Connection
NESTQUANT_MT5_BASE_URL=http://127.0.0.1:5001
NESTQUANT_MT5_TIMEOUT=10.0
NESTQUANT_MT5_MAGIC=0
NESTQUANT_MT5_DEVIATION=10

# Account
NESTQUANT_ACCOUNT_BALANCE=5000000
NESTQUANT_LEVERAGE=100

# Risk Management
NESTQUANT_RISK_PCT=0.003
NESTQUANT_MAX_POSITIONS=10
NESTQUANT_MAX_LOT_PER_PAIR=1.0
NESTQUANT_MAX_TOTAL_EXPOSURE=10.0
NESTQUANT_MAX_DAILY_LOSS=0.03
NESTQUANT_MAX_DD=0.10

# Health Monitoring
NESTQUANT_HEALTH_INTERVAL=30.0
NESTQUANT_MAX_FAILURES=3

# Logging
NESTQUANT_LOG_DIR=/tmp/nestquant_s7_logs

# Policy
NESTQUANT_POLICY_VERSION=s7-1.0.0
